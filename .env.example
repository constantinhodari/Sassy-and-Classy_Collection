# ─────────────────────────────────────────────────────────────────────
# Sassy & Classy Collections — environment template
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas (REQUIRED) ─────────────────────────────────────────
# Full connection string from Atlas → Connect → Drivers.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name that stores products, images, orders, inventory & settings.
MONGODB_DB=sassy_classy
# GridFS bucket that stores uploaded product image bytes.
MONGODB_IMAGE_BUCKET=productImages

# ── Administrator authorization (REQUIRED for uploads & edits) ───────
# Password used on the /admin login screen.
ADMIN_PASSWORD=Sassy_Classy@123
# Long random string used to sign the admin session cookie.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=Sassy_Classy@1234

# ── Product image uploads ────────────────────────────────────────────
# Maximum size per uploaded image, in megabytes.
MAX_IMAGE_UPLOAD_MB=5
# Development only: allow http:// image URLs.
# Keep `false` in production so images are always served over HTTPS.
ALLOW_INSECURE_IMAGE_URLS=false
